-- Run this once in Supabase: Dashboard -> SQL Editor -> New query -> paste -> Run.
-- Creates the table the website's contact form saves into.

create table if not exists public.contact_messages (
  id          bigint generated always as identity primary key,
  created_at  timestamptz not null default now(),
  name        text not null check (char_length(name)    between 1 and 100),
  email       text not null check (char_length(email)   between 3 and 200),
  company     text          check (char_length(company) <= 120),
  need        text          check (char_length(need)    <= 50),
  message     text not null check (char_length(message) between 1 and 5000),
  page        text          check (char_length(page)    <= 200)
);

-- Visitors may only INSERT. No one can read, change or delete rows with the
-- public key; you read messages in Dashboard -> Table Editor.
alter table public.contact_messages enable row level security;

drop policy if exists "Website visitors can send a message" on public.contact_messages;
create policy "Website visitors can send a message"
  on public.contact_messages
  for insert
  to anon
  with check (true);

grant insert on public.contact_messages to anon;
